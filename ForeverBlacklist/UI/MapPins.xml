<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Button name="ForeverBlacklistMapPinTemplate" mixin="ForeverBlacklistMapPinMixin" virtual="true">
        <Size x="22" y="22"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Glow" file="Interface\Cooldown\star4" alphaMode="ADD">
                    <Size x="44" y="44"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\TargetingFrame\UI-RaidTargetingIcon_8" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Class">
                    <Size x="13" y="13"/>
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="5" y="-5"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Animations>
            <AnimationGroup parentKey="Pulse" looping="BOUNCE">
                <Scale childKey="Glow" scaleX="1.6" scaleY="1.6" duration="0.6" smoothing="IN_OUT"/>
            </AnimationGroup>
        </Animations>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEnter method="OnMouseEnter"/>
            <OnLeave method="OnMouseLeave"/>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>
</Ui>
